@model Portfolio.ViewModels.HomePageVm
@{
    ViewData["Title"] = "Home";
}

<section class="page-intro hero">
    <h2>HETO NA KAMI!</h2>
    <p>@Model.Team.Tagline</p>
    <div class="pill-links">
        @foreach (var m in Model.Members)
        {
            <a class="pill" style="--label: @m.LabelColor"
               asp-controller="Portfolio" asp-action="Show" asp-route-slug="@m.Slug">@m.FullName</a>
        }
    </div>
</section>
