@model Portfolio.ViewModels.PortfolioPageVm
@*
    marc's personal portfolio. Build it here, on branch portfolio/marc.
    Your files:  this page, wwwroot/css/portfolio/marc.css, wwwroot/images/portfolio/marc/
*@
@{
    var me = Model.Member;
    ViewData["Title"] = me.FullName;
}

@section Styles {
    <link rel="stylesheet" href="~/css/portfolio/marc.css" asp-append-version="true" />
}

<article class="pf--marc" style="--accent: @me.AccentColor; --label: @me.LabelColor">
    <section class="page-intro">
        <h2>@me.FullName</h2>
        <p>lagay kayo dito</p>
    </section>
</article>
