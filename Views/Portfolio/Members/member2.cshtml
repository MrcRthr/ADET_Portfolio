@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Isabella Nicole | Portfolio</title>
  
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://unpkg.com/typed.js@2.1.0/dist/typed.umd.js"></script>
  
  <link rel="stylesheet" href="~/css/style.css">
</head>
<body>

  <header>
    <a href="#home" class="logo nav-trigger">isel<span>.dev</span></a>
    <div id="menu-icon"><i class="fas fa-bars"></i></div>
    <nav class="navbar">
      <ul class="nav-links">
        <li><a href="#home" class="nav-item active">Home</a></li>
        <li><a href="#aboutme" class="nav-item">About Me</a></li>
        <li><a href="#skills" class="nav-item">Skills</a></li>
        <li><a href="#education" class="nav-item">Education</a></li>
        <li><a href="#projects" class="nav-item">Projects</a></li>
        <li><a href="#contact" class="nav-item">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <!-- HOME SECTION -->
    <section id="home" class="section active">
      <div class="home-content">
        <h1>Hi, I'm <span class="typing-name"></span></h1>
        <h3>I'm <span class="multiple-text"></span></h3>
        
        <div class="social-icons">
          <a href="https://github.com/" target="_blank"><i class="fab fa-github"></i></a>
          <a href="https://linkedin.com/" target="_blank"><i class="fab fa-linkedin"></i></a>
          <a href="#contact" class="nav-trigger"><i class="fas fa-envelope"></i></a>
        </div>
        
        <a href="#aboutme" class="btn nav-trigger">More About Me</a>
      </div>

      <div class="home-img">
        <img src="~/images/main.jpg" alt="Isabella Profile" class="img-main">
        <img src="~/images/hoverpic.jpg" alt="Isabella Hover" class="img-hover">
      </div>
    </section>

    <!-- ABOUT ME SECTION -->
    <section id="aboutme" class="section">
      <h2 class="heading">About <span>Me</span></h2>
      
      <div class="about-container">
        <div class="about-content">
          <div class="about-left">
            <div class="about-img">
              <img src="~/images/main.jpg" alt="Isabella Profile" class="img-default">
              <img src="~/images/hoverpic.jpg" alt="Isabella Hover" class="img-hover">
            </div>

            <div class="about-stats">
              <div class="stat-card">
                <i class="fas fa-graduation-cap"></i>
                <h4>BSCS</h4>
                <p>2nd Year</p>
              </div>
              <div class="stat-card">
                <i class="fas fa-laptop-code"></i>
                <h4>Projects</h4>
                <p>Web & Apps</p>
              </div>
            </div>
          </div>

          <div class="about-text">
            <h3>Passionate Computer Science Student</h3>
            <p class="fade-up-desc">
              I am currently studying at the Polytechnic University of the Philippines - Sta. Mesa, Manila, pursuing a Bachelor of Science in Computer Science. Alongside my technical studies, I am deeply involved in student tech chapters and community-led initiatives, taking on roles in logistics, operations, and documentation.
            </p>
          
            <div class="about-interests">
              <h4><i class="fas fa-sparkles"></i>Core Focus & Interests</h4>
              <div class="interest-tags">
                <span class="tag"><i class="fas fa-layer-group"></i> Full-Stack Fundamentals</span>
                <span class="tag"><i class="fas fa-code"></i> Software Development</span>
                <span class="tag"><i class="fas fa-mobile-screen-button"></i> Application Development</span>
              </div>
            </div>
            
            <div class="about-btns">
              <a href="#projects" class="btn nav-trigger"><i class="fas fa-folder-open"></i> View Projects</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SKILLS SECTION -->
    <section id="skills" class="section">
      <h2 class="heading">My <span>Skills</span></h2>
      <div class="grid-container">
        <div class="info-card">
          <i class="fas fa-code card-icon"></i>
          <h3>Languages</h3>
          <p>C, Java, C#, HTML5, CSS3, JavaScript</p>
        </div>
        <div class="info-card">
          <i class="fas fa-database card-icon"></i>
          <h3>Frameworks & Tools</h3>
          <p>ASP.NET Core MVC, Supabase, Git & GitHub, Figma, VS Code</p>
        </div>
        <div class="info-card">
          <i class="fas fa-microchip card-icon"></i>
          <h3>Core CS Concepts</h3>
          <p>Data Structures & Algorithms, Object-Oriented Programming, Digital Logic Design</p>
        </div>
      </div>
    </section>

    <!-- EDUCATION SECTION -->
    <section id="education" class="section">
      <h2 class="heading">My <span>Education</span></h2>
      <div class="grid-container">
        <div class="info-card">
          <i class="fas fa-university card-icon"></i>
          <span class="badge">2025 – Present</span>
          <h3>Polytechnic University of the Philippines</h3>
          <p><strong>Bachelor of Science in Computer Science</strong><br>Sta. Mesa, Manila</p>
        </div>
        <div class="info-card">
          <i class="fas fa-users card-icon"></i>
          <span class="badge">Student Organizations</span>
          <h3>Campus Leadership & Tech Chapters</h3>
          <p>ANGAT ISKOLAR PUP • Google Developer Groups on Campus PUP • Cisco NetConnect PUP • PUP ASCII</p>
        </div>
      </div>
    </section>

    <!-- PROJECTS SECTION -->
    <section id="projects" class="section">
      <h2 class="heading">Featured <span>Projects</span></h2>
      <div class="grid-container">
        <div class="info-card">
          <i class="fas fa-utensils card-icon"></i>
          <h3>Ikaw Bahala (IB)</h3>
          <p>A group hangout and food decision-making app featuring anonymous blind swiping and local venue filters around Sta. Mesa.</p>
          <span class="tech-stack">Figma • Supabase</span>
        </div>
        <div class="info-card">
          <i class="fas fa-route card-icon"></i>
          <h3>GiraPH</h3>
          <p>A local transit, route guide, and community events discovery platform designed for easier city commuting.</p>
          <span class="tech-stack">System Design • Prototyping</span>
        </div>
      </div>
    </section>

    <!-- CONTACT SECTION -->
    <section id="contact" class="section">
      <h2 class="heading">Contact <span>Me</span></h2>
      <div class="section-container">
        <p class="section-desc">Feel free to reach out for collaborations, student org initiatives, or project opportunities!</p>
        <div class="grid-container" style="margin-top: 2.5rem;">
          <div class="info-card">
            <i class="fas fa-envelope card-icon"></i>
            <h3>Email</h3>
            <p>manaognicole83@gmail.com</p>
          </div>
          <div class="info-card">
            <i class="fab fa-github card-icon"></i>
            <h3>GitHub</h3>
            <p>github.com/Islncl25</p>
          </div>
          <div class="info-card">
            <i class="fas fa-location-dot card-icon"></i>
            <h3>Location</h3>
            <p>Metro Manila, Philippines</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script src="~/js/script.js"></script>
</body>
</html>