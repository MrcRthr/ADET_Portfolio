@model Portfolio.ViewModels.PortfolioListVm
@{
    ViewData["Title"] = "Portfolios";
}

@section Styles {
    <link rel="stylesheet" href="~/css/portfolio.css" asp-append-version="true" />
}

<section class="page-intro">
    <h2>TIG-ISA KAMI!</h2>
    <p>Each of us built our own portfolio on our own branch. Pick one.</p>
</section>

<section class="portfolio-list" aria-label="Member portfolios">
    @foreach (var m in Model.Members)
    {
        <a class="portfolio-card" asp-action="Show" asp-route-slug="@m.Slug"
           style="--accent: @m.AccentColor; --label: @m.LabelColor; --tilt: @(m.Tilt / 3)deg">
            <img class="portfolio-card-photo" src="@Url.Content(m.CardImage)" alt="" />
            <span class="portfolio-card-name">@m.FullName</span>
            <span class="portfolio-card-role">@m.Role</span>
        </a>
    }
</section>
